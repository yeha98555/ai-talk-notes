.DS_Store

# Editor / OS cruft
*.swp
*~
Thumbs.db

# Build artifacts — generated by `npm run build`, built fresh by Vercel on deploy
# (strategy B: don't commit the ~1.4 MB pages; keeps diffs clean). Run
# `npm run build` locally before opening index.html or `tools/i18n-check.mjs`.
index.html
index.zh.html

# Vercel
.vercel/

# Local planning docs & agent scratch (not part of the published site)
docs/
.superpowers/

# Secrets — never commit API keys. gen-note.mjs reads ANTHROPIC_API_KEY from the
# environment; use `node --env-file=.env.local tools/gen-note.mjs`. The .example
# template (placeholder only) is intentionally NOT ignored.
.env
.env.local
.env.*
!.env.example
